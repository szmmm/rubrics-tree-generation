# Copy to .env, fill in the values, then: source .env
# Any OpenAI-compatible endpoint.
export RT_BASE_URL="http://<host>:<port>/v1"
export RT_API_KEY=""
export RT_MODEL=""
# Optional: one draft per model, comma-separated. This replaces --drafts.
# export RT_DRAFT_MODELS="model-a,model-b,model-c"
# Optional: a different model for the critic stage.
# export RT_CRITIC_MODEL=""
# Optional: thinking level for every call, default high. low | high | max, or off
# for an endpoint without thinking.
# export RT_REASONING_EFFORT="max"
# Optional: output token cap per call, reasoning included. Default 131072.
# export RT_MAX_TOKENS="131072"
